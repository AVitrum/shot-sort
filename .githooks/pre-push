#!/bin/sh
# Last check before anything leaves this machine: refuses a push if any outgoing commit, not just the
# newest, ever contained a forbidden path. Removing a file in a later commit does not remove it from history.
# git calls this with "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
. "$(git rev-parse --show-toplevel)/.githooks/safety-rules.sh"

zero=0000000000000000000000000000000000000000
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi

    paths=$(git log --format= --name-only --diff-filter=ACMR $range | sort -u)
    bad=$(printf '%s\n' "$paths" | while IFS= read -r path; do
        [ -n "$path" ] || continue
        problem=$(path_problem "$path")
        [ -z "$problem" ] || echo "  $path: $problem"
    done)
    if [ -n "$bad" ]; then
        echo "BLOCKED push of $local_ref: history contains forbidden files:" >&2
        printf '%s\n' "$bad" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "Remove them from history before pushing; a later commit that deletes them is not enough." >&2
    exit 1
fi
