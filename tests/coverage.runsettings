<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings for CI, passed to dotnet test with the settings option (see ci.yml). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Source-generated regex and P/Invoke code is not ours to test. -->
          <ExcludeByFile>**/obj/**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
