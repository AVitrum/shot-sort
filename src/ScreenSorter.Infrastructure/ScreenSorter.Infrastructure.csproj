<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WPF imaging (WIC) for decoding/resizing screenshots, ADR-0003. -->
    <UseWPF>true</UseWPF>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenSorter.Core\ScreenSorter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK drops System.IO from implicit usings (clash with Shapes.Path). -->
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="ScreenSorter.Tests" />
  </ItemGroup>

</Project>
