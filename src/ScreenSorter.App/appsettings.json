{
  "Paths": {
    "WatchFolders": [ "%USERPROFILE%\\Pictures\\Screenshots" ],
    "SortedRoot": "%USERPROFILE%\\Pictures\\Screenshots",
    "ReviewFolder": "_Review",
    "DatabasePath": "%LOCALAPPDATA%\\ScreenSorter\\screensorter.db",
    "LogFolder": "%LOCALAPPDATA%\\ScreenSorter\\logs"
  },
  "Intake": {
    "Extensions": [ ".png", ".jpg", ".jpeg" ],
    "RescanIntervalSeconds": 60,
    "StabilityPollMilliseconds": 500,
    "StabilityTimeoutSeconds": 30,
    "BatchQuietSeconds": 5
  },
  "Focus": {
    "HistorySize": 256,
    "IgnoredProcesses": [ "ScreenClippingHost.exe", "SnippingTool.exe", "ShellExperienceHost.exe", "ScreenSorter.App.exe" ]
  },
  "Rules": {
    "BrowserProcesses": [ "chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe" ],
    "GameLibraryMarkers": [
      "\\steamapps\\common\\",
      "\\Epic Games\\",
      "\\GOG Galaxy\\Games\\",
      "\\GOG Games\\",
      "\\Riot Games\\",
      "\\EA Games\\",
      "\\Ubisoft Game Launcher\\games\\"
    ],
    "GameExcludeMarkers": [ "\\Epic Games\\Launcher\\", "\\Riot Games\\Riot Client\\" ],
    "GameAliases": {
      "cs2": "Counter-Strike 2"
    },
    "AppRules": [
      { "Processes": [ "Discord.exe" ], "Target": "Chat/Discord" },
      { "Processes": [ "Telegram.exe" ], "Target": "Chat/Telegram" },
      { "Processes": [ "WhatsApp.exe" ], "Target": "Chat/WhatsApp" },
      { "Processes": [ "slack.exe" ], "Target": "Chat/Slack" },
      { "Processes": [ "Zoom.exe" ], "Target": "Calls", "Name": "Zoom" },
      { "Processes": [ "ms-teams.exe" ], "Target": "Calls", "Name": "Teams" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Meet" ], "Target": "Calls", "Name": "Meet" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Zoom" ], "Target": "Calls", "Name": "Zoom" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Teams" ], "Target": "Calls", "Name": "Teams" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Discord" ], "Target": "Chat/Discord" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Telegram" ], "Target": "Chat/Telegram" },
      { "Processes": [ "@browser" ], "TitleContains": [ "WhatsApp" ], "Target": "Chat/WhatsApp" },
      { "Processes": [ "@browser" ], "TitleContains": [ "Slack" ], "Target": "Chat/Slack" },
      { "Processes": [ "@browser" ], "TitleContains": [ "YouTube", "Twitch", "Netflix" ], "Target": "Streaming" },
      { "Processes": [ "@browser" ], "Target": "Browser" },
      { "Processes": [ "devenv.exe", "rider64.exe", "Code.exe", "WindowsTerminal.exe" ], "Target": "Code" },
      { "Processes": [ "WINWORD.EXE", "EXCEL.EXE", "POWERPNT.EXE", "Acrobat.exe" ], "Target": "Documents" },
      { "Processes": [ "explorer.exe" ], "Target": "Desktop" }
    ]
  },
  "LmStudio": {
    "BaseUrl": "http://localhost:1234/v1",
    "Model": "google/gemma-4-12b-qat",
    "MaxImageSide": 1280,
    "MaxTokens": 1024,
    "JpegQuality": 90,
    "TimeoutSeconds": 180,
    "TtlSeconds": 300,
    "RetryMinutes": 5,
    "Categories": {
      "Game": "Games",
      "Chat": "Chat",
      "Calls": "Calls",
      "Code": "Code",
      "Streaming": "Streaming",
      "Documents": "Documents",
      "Browser": "Browser",
      "Desktop": "Desktop",
      "Other": "Other"
    }
  },
  "Qdrant": { "Url": "http://localhost:6333", "Collection": "screenshots" },
  "Thresholds": {
    "ExampleSimilarity": 0.90,
    "ExampleAgreement": 0.8,
    "VisionConfidence": 0.70,
    "UniformMaxStdDev": 2.5
  },
  "Idle": {
    "NoInputMinutes": 5,
    "MaxGpuUtilPercent": 20,
    "SkipWhenFullscreen": true,
    "CheckIntervalSeconds": 30
  },
  "Notifications": { "Mode": "BatchSummary" },
  "Startup": { "RunAtLogin": true },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
