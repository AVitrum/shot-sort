<Window x:Class="ScreenSorter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSorter settings"
        Icon="/Assets/app.ico"
        Width="900" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="16,8,24,16" LastChildFill="True">
            <Button DockPanel.Dock="Left" Click="OnOpenGuide" Width="172" VerticalAlignment="Bottom"
                    AutomationProperties.Name="How it works">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Margin="0,0,8,0" />
                    <TextBlock Text="How it works" />
                </StackPanel>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="Save and restart" IsDefault="True" Click="OnSave" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="88" />
            </StackPanel>
            <TextBlock x:Name="Problems" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Margin="16,0,16,0" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl x:Name="Tabs" Style="{StaticResource SideNavigation}" ItemContainerStyle="{StaticResource SideNavigationItem}">
            <TabItem Header="General" Tag="&#xE713;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,24,8">
                        <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16" Text="Where screenshots come from, where they go, and how the app behaves." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Watch folders" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="New screenshots are picked up from these folders." />
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                        <Button Content="Add..." Click="OnAddWatchFolder" Margin="0,0,0,6" MinWidth="88" />
                                        <Button Content="Remove" Click="OnRemoveWatchFolder" MinWidth="88" />
                                    </StackPanel>
                                    <ListBox x:Name="WatchFolderList" ItemsSource="{Binding WatchFolders}" MinHeight="80" MaxHeight="120" Background="Transparent"
                                             BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Sorted screenshots go under" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Folders such as Games and Chat are created here." />
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseSortedRoot" Margin="8,0,0,0" MinWidth="88" />
                                    <TextBox x:Name="SortedRootBox" Text="{Binding SortedRoot, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Review folder name" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Screenshots it could not place with confidence wait here for you." />
                                <TextBox Text="{Binding ReviewFolder, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding BacklogEnabled}" Margin="0,0,0,12"
                                          AutomationProperties.Name="Sort screenshots taken while the app was not running">
                                    <StackPanel>
                                        <TextBlock Text="Sort screenshots taken while the app was not running" />
                                        <TextBlock Style="{StaticResource Hint}" Text="This includes screenshots already in the watch folders. They are sorted by what they show." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding RenameMovedFiles}" Margin="0,0,0,12"
                                          AutomationProperties.Name="Rename screenshots I move to another folder">
                                    <StackPanel>
                                        <TextBlock Text="Rename screenshots I move to another folder" />
                                        <TextBlock Style="{StaticResource Hint}" Text="The new name matches the folder. A name you chose yourself is kept." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,12"
                                          AutomationProperties.Name="Show a notification after each batch">
                                    <StackPanel>
                                        <TextBlock Text="Show a notification after each batch" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Says how many were sorted and how many need review." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StartWithWindowsBox" AutomationProperties.Name="Start with Windows">
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Otherwise screenshots wait until you start the app." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="App rules" Tag="&#xE71D;">
                <DockPanel Margin="16,16,24,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="App rules" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Which folder each focused app goes to. The first matching row wins, so order matters." />

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Browser processes" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Use @browser in a rule's Processes to mean any of these." />
                            <TextBox Text="{Binding BrowserProcesses, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Separate several values with commas. Target is a folder such as Code or Chat/Discord." />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add rule" Click="OnAddRule" Margin="0,0,8,0" MinWidth="88" />
                                <Button Content="Remove" Click="OnRemoveRule" Margin="0,0,8,0" MinWidth="88" />
                                <Button Content="Move up" Click="OnMoveRuleUp" Margin="0,0,8,0" MinWidth="88" />
                                <Button Content="Move down" Click="OnMoveRuleDown" MinWidth="88" />
                            </StackPanel>
                            <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Processes" Binding="{Binding Processes}" Width="2*" />
                                    <DataGridTextColumn Header="Title contains" Binding="{Binding TitleContains}" Width="1.5*" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.2*" />
                                    <DataGridTextColumn Header="File name" Binding="{Binding Name}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Games" Tag="&#xE7FC;">
                <DockPanel Margin="16,16,24,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Games" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Installed Steam and Epic games and your Games folders are already known. Add only what it misses." />

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Extra known games" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="One title per line." />
                            <TextBox Text="{Binding ExtraGameTitles, UpdateSourceTrigger=PropertyChanged}" Height="96"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Aliases" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Name a game whose exe or folder differs from its title, for example StarRail and Honkai Star Rail." />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add alias" Click="OnAddAlias" Margin="0,0,8,0" MinWidth="88" />
                                <Button Content="Remove" Click="OnRemoveAlias" MinWidth="88" />
                            </StackPanel>
                            <DataGrid x:Name="AliasesGrid" ItemsSource="{Binding GameAliases}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Exe, folder or title" Binding="{Binding Key}" Width="*" />
                                    <DataGridTextColumn Header="Game title" Binding="{Binding Title}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Vision model" Tag="&#xE890;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,24,8">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Vision model" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="A model in LM Studio looks at screenshots that the rules and examples could not place." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="LM Studio URL" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LmStudioUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                                <TextBlock Style="{StaticResource Heading}" Text="Model" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LmStudioModel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Run the model only when" Margin="0,0,0,10" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding NoInputMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="No input for this many minutes" />
                                    <TextBlock Text="No input for this many minutes" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding MaxGpuUtilPercent, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="GPU load at or below this percent" />
                                    <TextBlock Text="GPU load at or below this percent" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox IsChecked="{Binding SkipWhenFullscreen}" Content="No fullscreen app in focus" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Folder for each category" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Where the model's answers end up." />
                                <DataGrid x:Name="CategoriesGrid" ItemsSource="{Binding Categories}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Key}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Expander Header="Fine-tuning" Margin="0,0,0,10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Values from 0 to 1. The defaults suit most people." />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding VisionConfidence, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Vision answers below this go to review" />
                                    <TextBlock Text="Vision answers below this go to review" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding ExampleSimilarity, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Similarity an example needs to count" />
                                    <TextBlock Text="Similarity an example needs to count" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding ExampleAgreement, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Share of examples that must agree" />
                                    <TextBlock Text="Share of examples that must agree" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Privacy" Tag="&#xE72E;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,24,8">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Privacy" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="Everything stays on this PC. These settings limit how long personal details are kept here." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Window titles and program paths" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="A window title can show a chat name, a document or a web page. The app records it with each decision so that you can see why a screenshot went where it did. Older ones are erased. The record that a file was sorted stays, or the app would mistake old files for ones you placed yourself." />
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding WindowTitleDays, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Days to keep them. 0 means they are not stored" />
                                    <TextBlock Text="Days to keep them. 0 means they are not stored" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Erase them now" Click="OnEraseWindowTitles" MinWidth="88" />
                                    <TextBlock x:Name="EraseMessage" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Log files" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="They list file names and the focused program, and help when something goes wrong." />
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding LogDays, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Days to keep log files" />
                                    <TextBlock Text="Days to keep log files" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
