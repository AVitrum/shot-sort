<Window x:Class="ScreenSorter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSorter settings"
        Icon="/Assets/app.ico"
        Width="780" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E2E2" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F5F5F" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="Save and restart" IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            </StackPanel>
            <TextBlock x:Name="Problems" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="General">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="Watch folders" />
                    <DockPanel Grid.Row="1" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                            <Button Content="Add..." Click="OnAddWatchFolder" Margin="0,0,0,6" />
                            <Button Content="Remove" Click="OnRemoveWatchFolder" />
                        </StackPanel>
                        <ListBox x:Name="WatchFolderList" ItemsSource="{Binding WatchFolders}" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Style="{StaticResource Heading}" Text="Sorted screenshots go under" />
                    <DockPanel Grid.Row="3" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseSortedRoot" Margin="8,0,0,0" />
                        <TextBox x:Name="SortedRootBox" Text="{Binding SortedRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource Heading}" Text="Review folder name" />
                        <TextBox Text="{Binding ReviewFolder, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,14" />
                        <CheckBox IsChecked="{Binding BacklogEnabled}" Content="Sort screenshots taken while the app was not running" />
                        <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="Show a notification after each batch" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="App rules">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Which folder each focused app goes to. The first matching row wins. Separate several values with commas. Use @browser in Processes for any browser listed below. Target is a folder such as Code or Chat/Discord." />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Heading}" Text="Browser processes" />
                        <TextBox Text="{Binding BrowserProcesses, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="Move up" Click="OnMoveRuleUp" Margin="0,0,0,6" />
                        <Button Content="Move down" Click="OnMoveRuleDown" />
                    </StackPanel>
                    <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Processes" Binding="{Binding Processes}" Width="2*" />
                            <DataGridTextColumn Header="Title contains" Binding="{Binding TitleContains}" Width="1.5*" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.2*" />
                            <DataGridTextColumn Header="File name" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Games">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}"
                               Text="Aliases name a game whose exe or folder differs from its title, for example StarRail and Honkai Star Rail." />
                    <DataGrid x:Name="AliasesGrid" Grid.Row="1" ItemsSource="{Binding GameAliases}" Margin="0,0,0,14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Exe, folder or title" Binding="{Binding Key}" Width="*" />
                            <DataGridTextColumn Header="Game title" Binding="{Binding Title}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource Hint}"
                               Text="Extra known games, one per line. Installed Steam and Epic games and your Games folders are already known." />
                    <TextBox Grid.Row="3" Text="{Binding ExtraGameTitles, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </Grid>
            </TabItem>

            <TabItem Header="Vision and idle">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Heading}" Text="LM Studio URL" />
                            <TextBox Text="{Binding LmStudioUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Heading}" Text="Model" />
                            <TextBox Text="{Binding LmStudioModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />

                            <TextBlock Style="{StaticResource Heading}" Text="Run the vision model only when" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding NoInputMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="No input for this many minutes" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding MaxGpuUtilPercent, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="GPU load at or below this percent" VerticalAlignment="Center" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding SkipWhenFullscreen}" Content="No fullscreen app in focus" Margin="0,0,0,18" />

                            <TextBlock Style="{StaticResource Heading}" Text="Confidence, from 0 to 1" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding VisionConfidence, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Vision answers below this go to review" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding ExampleSimilarity, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Similarity an example needs to count" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="64" Text="{Binding ExampleAgreement, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Share of examples that must agree" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Heading}" Text="Folder for each category" />
                            <DataGrid x:Name="CategoriesGrid" ItemsSource="{Binding Categories}" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Key}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
