<Window x:Class="ScreenSorter.App.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:status="clr-namespace:ScreenSorter.Core.Status;assembly=ScreenSorter.Core"
        Title="ScreenSorter activity"
        Icon="/Assets/app.ico"
        Width="960" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <TabControl x:Name="Tabs" Style="{StaticResource SideNavigation}" ItemContainerStyle="{StaticResource SideNavigationItem}">
        <TabItem x:Name="StatusTab" Header="Status" Tag="&#xE9D9;">
            <DockPanel Margin="16,16,24,16">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Check now" Click="OnCheckNow" MinWidth="88" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Status" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StatusList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type status:ServiceCheck}">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock x:Name="StateIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" FontSize="20" Margin="0,0,14,0"
                                                   Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Heading}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
                                            <TextBlock x:Name="FixText" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Fix}" />
                                            <DockPanel x:Name="CommandRow" Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Content="Copy" Tag="{Binding FixCommand}" Click="OnCopyCommand" Margin="8,0,0,0" MinWidth="72" />
                                                <TextBox IsReadOnly="True" Text="{Binding FixCommand, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                                         AutomationProperties.Name="Command to run" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static status:ServiceState.Waiting}">
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE823;" />
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static status:ServiceState.Problem}">
                                        <Setter TargetName="StateIcon" Property="Text" Value="&#xE783;" />
                                        <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Fix}" Value="{x:Null}">
                                        <Setter TargetName="FixText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FixCommand}" Value="{x:Null}">
                                        <Setter TargetName="CommandRow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="HistoryTab" Header="History" Tag="&#xE81C;">
            <DockPanel Margin="16,16,24,16">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="History" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Where each screenshot went and why. Pick one to see it, undo the move, or put it somewhere else." />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefreshHistory" MinWidth="88" Margin="8,0,0,0" />
                    <ComboBox x:Name="HistoryFilter" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="OnHistoryFilterChanged"
                              AutomationProperties.Name="Show">
                        <ComboBoxItem Content="All screenshots" />
                        <ComboBoxItem Content="Needs review" />
                        <ComboBoxItem Content="Placed by the app" />
                        <ComboBoxItem Content="Placed by you" />
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="HistorySearch" TextChanged="OnHistorySearchChanged" AutomationProperties.Name="Search by file or folder" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True"
                              SelectionChanged="OnHistorySelectionChanged" AutomationProperties.Name="Screenshots">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="118" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryDetails" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" Padding="4">
                                <Image x:Name="HistoryPreview" Height="150" Stretch="Uniform" AutomationProperties.Name="Preview" />
                            </Border>
                            <TextBlock x:Name="HistoryName" Style="{StaticResource Heading}" Margin="0,0,0,4" />
                            <TextBlock x:Name="HistoryWhy" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="HistoryMissing" Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="The file is no longer in this folder." />
                            <Button x:Name="UndoButton" Content="Undo the move" Click="OnUndo" HorizontalAlignment="Stretch" Margin="0,8,0,6" />
                            <Button x:Name="MoveButton" Content="Move to..." Click="OnMoveTo" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <Button x:Name="ShowButton" Content="Show in folder" Click="OnShowInFolder" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <TextBlock x:Name="HistoryMessage" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="AccuracyTab" Header="Accuracy" Tag="&#xE9F9;">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,24,16">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Accuracy" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="Measured against what you did afterwards. A screenshot you moved counts as a miss, and one nobody looked at counts as right, so these numbers lean optimistic." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="By stage" Margin="0,0,0,8" />
                            <DataGrid x:Name="AccuracyGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      IsReadOnly="True" CanUserAddRows="False" AutomationProperties.Name="Accuracy by stage">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*" />
                                    <DataGridTextColumn Header="Placed" Binding="{Binding Placed}" Width="80" />
                                    <DataGridTextColumn Header="You moved" Binding="{Binding Moved}" Width="110" />
                                    <DataGridTextColumn Header="Kept" Binding="{Binding Kept}" Width="70" />
                                    <DataGridTextColumn Header="Sent to review" Binding="{Binding Review}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ReviewedText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Most common corrections" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="If one game keeps being mistaken for another, a few more examples of it help most: drag some of its screenshots into its folder." />
                            <DataGrid x:Name="CorrectionsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      IsReadOnly="True" CanUserAddRows="False" AutomationProperties.Name="Most common corrections">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="The app chose" Binding="{Binding From}" Width="*" />
                                    <DataGridTextColumn Header="You moved it to" Binding="{Binding To}" Width="*" />
                                    <DataGridTextColumn Header="Screenshots" Binding="{Binding Count}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
