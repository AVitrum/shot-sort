<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenSorter.Core\ScreenSorter.Core.csproj" />
    <ProjectReference Include="..\..\src\ScreenSorter.Infrastructure\ScreenSorter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same settings as the app, so the probe tests exactly what the app would send. -->
    <None Include="..\..\src\ScreenSorter.App\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
